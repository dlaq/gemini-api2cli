# Production Dockerfile for @google/gemini-cli-a2a-server
#
# Multi-stage build: compiles TypeScript inside the image so the host
# doesn't need Node installed. Heavier first build than `Dockerfile.a2a`
# (~3-5 min vs ~30s) but avoids the "stale dist on host" footgun where
# `git checkout` doesn't touch ignored `dist/` directories — the source
# of the joshua.litt-removed-but-still-imported crash on upgrade.
#
# Use this when:
#   - The host doesn't have Node 20+ installed
#   - You want reproducible builds tied to the git tree only
#   - You want to avoid forgetting to `npm run build` between upgrades
#
# Switch by setting `dockerfile: Dockerfile.a2a.prod` in docker-compose.yml.

# ─── Builder stage ────────────────────────────────────────────────
FROM node:20-slim AS builder
WORKDIR /build

# Copy the complete workspace before npm ci. Some npm workspace lifecycle
# hooks are still executed even with --ignore-scripts in this repository
# (notably vscode-ide-companion generate:notices), so their source scripts
# must already exist when dependency installation runs.
COPY . .

# Install all workspace deps (including devDependencies — TS toolchain).
RUN npm ci --ignore-scripts

# Generate the git/version source files required by core/cli before TypeScript build.
RUN npm run generate

# Build in dependency order:
#   core → devtools → cli → a2a-server.
RUN npm run build --workspace @google/gemini-cli-core \
 && npm run build --workspace @google/gemini-cli-devtools \
 && npm run build --workspace @google/gemini-cli \
 && npm run build --workspace @google/gemini-cli-a2a-server

# ─── Runtime stage ────────────────────────────────────────────────
FROM node:20-slim AS runtime
WORKDIR /app

ENV NODE_ENV=production \
    CODER_AGENT_PORT=41242 \
    CODER_AGENT_HOST=0.0.0.0

# Reuse the dependency tree installed in the builder. The upstream runtime
# stage previously ran npm ci before copying workspace scripts; npm can still
# execute workspace lifecycle hooks (for example vscode-ide-companion's
# generate:notices), which makes the image build fail because those scripts
# are not present yet. Copying the already-installed tree is deterministic
# and avoids that ordering bug.
COPY package.json package-lock.json ./
COPY packages/core/package.json packages/core/
COPY packages/cli/package.json packages/cli/
COPY packages/devtools/package.json packages/devtools/
COPY packages/a2a-server/package.json packages/a2a-server/
COPY packages/sdk/package.json packages/sdk/
COPY packages/test-utils/package.json packages/test-utils/
COPY packages/vscode-ide-companion/package.json packages/vscode-ide-companion/
COPY --from=builder /build/node_modules ./node_modules

# npm workspaces may keep version-conflicting dependencies inside each
# workspace instead of hoisting them to the repository root.  The A2A server
# currently keeps @a2a-js/sdk here, and core/cli also have nested runtime
# dependencies.  Copy those workspace-local dependency trees as well.
COPY --from=builder /build/packages/a2a-server/node_modules ./packages/a2a-server/node_modules
COPY --from=builder /build/packages/core/node_modules       ./packages/core/node_modules
COPY --from=builder /build/packages/cli/node_modules        ./packages/cli/node_modules

# Copy compiled output + the bits the runtime actually needs.
COPY --from=builder /build/packages/core/dist           packages/core/dist
COPY --from=builder /build/packages/core/index.ts       packages/core/
COPY --from=builder /build/packages/cli/dist            packages/cli/dist
COPY --from=builder /build/packages/devtools/dist       packages/devtools/dist
COPY --from=builder /build/packages/devtools/client     packages/devtools/client
COPY --from=builder /build/packages/a2a-server/dist     packages/a2a-server/dist

# Drop privileges to the bundled non-root `node` user. Matches
# docker-compose's `user: "1000:1000"` mount.
RUN chown -R node:node /app
USER node

# Fail the image build immediately if a workspace-local runtime dependency
# is missing, instead of discovering it only after the container starts.
RUN cd /app/packages/a2a-server \
 && node -e "import('@a2a-js/sdk').then(()=>console.log('a2a sdk ok'))"

EXPOSE 41242
CMD ["node", "packages/a2a-server/dist/src/http/server.js"]
