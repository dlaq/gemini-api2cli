# Docker Hub 镜像
GEMINI_API2CLI_IMAGE=dlaq/gemini-api2cli:latest

# 宿主机暴露端口
GEMINI_API2CLI_PORT=41242

# Web 管理台 / API 鉴权 Token
# 建议改成较长的随机字符串
GEMINI_PROMPT_API_TOKEN=change-this-to-a-long-random-token

# 是否启用 A2A 协议层
ENABLE_A2A=false

# 可选：访问 Google 时使用代理
# HTTPS_PROXY=http://192.168.1.1:7890
# HTTP_PROXY=http://192.168.1.1:7890
# NO_PROXY=127.0.0.1,localhost

HTTPS_PROXY=
HTTP_PROXY=
NO_PROXY=127.0.0.1,localhost
